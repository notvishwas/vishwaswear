# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Vishwaswear
NEXT_PUBLIC_SITE_URL=https://vishwaswear.com

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Vishwaswear <orders@vishwaswear.com>"
# Receives new-order notifications
ADMIN_NOTIFICATION_EMAIL=
# Shown to customers as the support contact
SUPPORT_EMAIL=support@vishwaswear.com

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ─────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Never expose to the client.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
