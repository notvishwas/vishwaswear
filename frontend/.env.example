# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Vishwaswear
NEXT_PUBLIC_SITE_URL=https://vishwaswear.com
# Optional social profile URLs; links are hidden when unset
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Order access ─────────────────────────────────────
# Signs the links that open an order confirmation page. Use a long random string:
#   openssl rand -hex 32
ORDER_TOKEN_SECRET=

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Vishwaswear <orders@vishwaswear.com>"
# Receives new-order notifications
ADMIN_NOTIFICATION_EMAIL=
# Shown to customers as the support contact
SUPPORT_EMAIL=support@vishwaswear.com

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Images ───────────────────────────────────────────
# Extra hostnames next/image may load from, comma separated (the Supabase host is added automatically)
NEXT_PUBLIC_IMAGE_DOMAINS=images.unsplash.com

# ── Razorpay ─────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Never expose to the client.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
